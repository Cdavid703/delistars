# Copy this file to .env and set real secrets before running on a VPS

# Postgres (used by DB service and backend)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_postgres
POSTGRES_DB=delistars1
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=${POSTGRES_USER}
DB_PASSWORD=${POSTGRES_PASSWORD}
DB_NAME=${POSTGRES_DB}

# Backend
NODE_ENV=production
PORT=3000
API_PREFIX=/api/v1
# En producción agrega tu dominio real (ej: https://delistars.com). En local deja localhost.
CORS_ORIGIN=https://delistars.com,http://localhost,http://localhost:5173,http://localhost:80
JWT_SECRET=change_me_jwt_secret

# Frontend / Admin (Vite)
# IMPORTANTE: ruta RELATIVA. El gateway nginx enruta /api/ al backend internamente.
# NO uses http://localhost:3000/api/v1 — rompe en producción.
VITE_API_URL=/api/v1

# Firebase — necesarias para construir el servicio "domicilios" (mismo proyecto delistars-domicilios)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: cloudinary or other keys
# CLOUDINARY_URL=...
# SENTRY_DSN=...
