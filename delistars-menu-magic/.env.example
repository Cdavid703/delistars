# Copy this file to .env and set real secrets before running on a VPS

# Postgres (used by DB service and backend)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_postgres
POSTGRES_DB=delistars1
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=${POSTGRES_USER}
DB_PASSWORD=${POSTGRES_PASSWORD}
DB_NAME=${POSTGRES_DB}

# Backend
NODE_ENV=production
PORT=3000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost,http://localhost:5173,http://localhost:3000,http://localhost:80
JWT_SECRET=change_me_jwt_secret

# Frontend / Admin (Vite) - update to your VPS domain or use proxy
VITE_API_URL=http://localhost:3000/api/v1

# Optional: cloudinary or other keys
# CLOUDINARY_URL=...
# SENTRY_DSN=...
