# Copy this file to .env and set real secrets before running on a VPS

# Postgres (used by DB service and backend)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_postgres
POSTGRES_DB=delistars1
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=${POSTGRES_USER}
DB_PASSWORD=${POSTGRES_PASSWORD}
DB_NAME=${POSTGRES_DB}

# Backend
NODE_ENV=production
PORT=3000
API_PREFIX=/api/v1
# En producción agrega tu dominio real (ej: https://delistars.com). En local deja localhost.
CORS_ORIGIN=https://delistars.com,http://localhost,http://localhost:5173,http://localhost:80
# Auth admin (Firebase) — protege POST/PUT/DELETE de products, categories y sedes
FIREBASE_PROJECT_ID=delistars-domicilios
ADMIN_EMAILS=thebesta4321@gmail.com,cdavid.jaramillo@gmail.com
# Nº de proxies delante del backend para que req.ip refleje la IP real.
# En el VPS: nginx del host + gateway Docker = 2. En local sin proxy: 1.
TRUST_PROXY_HOPS=2

# Frontend / Admin (Vite)
# IMPORTANTE: ruta RELATIVA. El gateway nginx enruta /api/ al backend internamente.
# NO uses http://localhost:3000/api/v1 — rompe en producción.
VITE_API_URL=/api/v1

# Firebase — necesarias para construir el servicio "domicilios" (mismo proyecto delistars-domicilios)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: cloudinary or other keys
# CLOUDINARY_URL=...
# SENTRY_DSN=...

# Scheduler — abre/cierra config/client_platform automáticamente (5:30pm/11:30pm).
# Cuenta de Firebase Auth (correo/contraseña) dedicada y de permisos muy
# limitados (ver isAutoOpenBot() en firestore.rules) — NUNCA una llave de
# admin. Crear el usuario manualmente en Firebase Console > Authentication.
AUTO_OPEN_BOT_EMAIL=auto-open@delistars-domicilios.app
AUTO_OPEN_BOT_PASSWORD=change_me_bot_password
