# Database - PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=password
DB_NAME=delistars

# Server
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# JWT
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here_change_in_production

# Auth admin (Firebase) — protege POST/PUT/DELETE de products, categories, sedes, trabajadores
FIREBASE_PROJECT_ID=delistars-domicilios
ADMIN_EMAILS=thebesta4321@gmail.com,cdavid.jaramillo@gmail.com,josemigeul44@gmail.com

# Nº de proxies delante del backend (rate-limit usa la IP real). Local sin proxy: 1.
TRUST_PROXY_HOPS=1
