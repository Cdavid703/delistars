rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
// Reglas de seguridad de Firestore — DeliStars (app de domicilios)
//
// Modelo de auth:
//   • Staff (admin/cajero/domiciliario): Google sign-in.
//   • Clientes: sign-in anónimo (signInAnonymously). Tienen uid pero no email.
//
// Roles:
//   • Admin: lista hardcodeada (DEBE coincidir con ADMIN_EMAILS del front —
//     ver src/services/roles.js y `npm run check:emails`).
//   • Cajero/Domiciliario: existe un doc cuyo ID es su email en
//     roles_cashiers / roles_drivers (así los resuelve AuthContext).
//
// ⚠️ Probar en Rules Playground / emulador ANTES de desplegar a producción.
//    Rollback = restaurar las reglas anteriores en la consola de Firebase.
// ─────────────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function userEmail()  { return request.auth.token.email; }

    // Admins hardcodeados (sincronizar con ADMIN_EMAILS del front).
    function isAdmin() {
      return isSignedIn() && userEmail() in [
        'thebesta4321@gmail.com',
        'cdavid.jaramillo@gmail.com',
        'josemigeul44@gmail.com'
      ];
    }
    // Cajeros/domiciliarios "por defecto" hardcodeados (espejo de DEFAULT_CASHIERS
    // y DEFAULT_DRIVERS en src/services/roles.js). Pueden NO tener doc en Firestore,
    // por eso se reconocen aquí además del exists() de la colección dinámica.
    function isCashier() {
      return isSignedIn() && (
        userEmail() in [
          'lluis02martinez@gmail.com',
          'josemanuellondonorivillas@gmail.com',
          'vvillegasmazo@gmail.com',
          'yencytp@gmail.com',
          'cdavid.jaramillo@gmail.com',
          'thebesta4321@gmail.com'
        ]
        || exists(/databases/$(database)/documents/roles_cashiers/$(userEmail()))
      );
    }
    function isDriver() {
      return isSignedIn() && (
        userEmail() in [
          'cdavid.jaramillo@gmail.com',
          'josemanuellondonorivillas@gmail.com'
        ]
        || exists(/databases/$(database)/documents/roles_drivers/$(userEmail()))
      );
    }
    function isStaff() { return isAdmin() || isCashier() || isDriver(); }

    // ── Pedidos ────────────────────────────────────────────────────────────
    // Cliente: solo los suyos (clientUid == su uid). Staff: todos.
    match /orders/{orderId} {
      allow read:   if isStaff()
                    || (isSignedIn() && resource.data.clientUid == request.auth.uid);
      allow create: if isStaff()
                    || (isSignedIn() && request.resource.data.clientUid == request.auth.uid);
      allow update: if isStaff()
                    || (isSignedIn() && resource.data.clientUid == request.auth.uid);
      allow delete: if isAdmin();
    }

    // ── Config de la app (config/client_platform) ──────────────────────────
    match /config/{docId} {
      allow read:  if isSignedIn();
      allow write: if isCashier() || isAdmin();
    }

    // ── Listas de roles dinámicos ──────────────────────────────────────────
    // Cualquier usuario autenticado las lee (AuthContext resuelve su rol);
    // solo admin las modifica.
    match /roles_cashiers/{email} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }
    match /roles_drivers/{email} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }

    // ── Ubicación de domiciliarios (doc id = email del domiciliario) ────────
    match /driver_locations/{email} {
      allow read:  if isSignedIn();
      allow write: if isAdmin() || (isSignedIn() && userEmail() == email);
    }

    // ── Perfil de cliente (doc id = uid) ───────────────────────────────────
    // El campo "loyalty" (progreso de fidelización por sede) NUNCA lo escribe
    // el cliente — solo staff (lo actualiza el domiciliario al marcar entregado).
    // El cliente sí puede crear/actualizar el resto de su perfil (nombre, tel,
    // direcciones) con normalidad.
    match /customers/{uid} {
      allow read:   if isStaff() || (isSignedIn() && request.auth.uid == uid);
      allow create: if isStaff()
                    || (isSignedIn() && request.auth.uid == uid && !('loyalty' in request.resource.data));
      allow update: if isStaff()
                    || (
                      isSignedIn() && request.auth.uid == uid &&
                      !request.resource.data.diff(resource.data).affectedKeys().hasAny(['loyalty'])
                    );
      allow delete: if isAdmin();
    }

    // ── Premios de fidelización (subcolección de customers) ─────────────────
    // Solo staff puede CREAR un premio (otorgarlo al entregar el pedido #10,
    // #20 o #30). El cliente solo puede: marcar que ya lo vio (notified) o
    // canjear un premio propio que esté vigente y disponible — nunca inventar
    // uno, revivir uno vencido/ya usado, ni canjear el de otra persona (se
    // valida contra el pedido real referenciado).
    match /customers/{uid}/rewards/{rewardId} {
      allow read:   if isStaff() || (isSignedIn() && request.auth.uid == uid);
      allow create: if isStaff();
      allow delete: if isAdmin();
      allow update: if isStaff()
                    || (
                      isSignedIn() && request.auth.uid == uid &&
                      resource.data.status == 'available' &&
                      resource.data.expiresAt > request.time &&
                      (
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['notified'])
                        || (
                          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','redeemedAt','orderId','notified']) &&
                          request.resource.data.status == 'redeemed' &&
                          get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.clientUid == uid
                        )
                      )
                    );
    }

    // ── Turnos (horarios del equipo) ───────────────────────────────────────
    match /turnos/{weekId} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }

    // ── Contador de número de pedido (transacción) ─────────────────────────
    match /counters/{docId} {
      allow read, write: if isSignedIn();
    }

    // ── Postulaciones a vacantes (formulario público, sin login) ───────────
    match /vacantes_postulantes/{appId} {
      allow create: if true;            // postulación pública
      allow read, update, delete: if isAdmin();
    }

    // ── Todo lo demás: denegado ────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
