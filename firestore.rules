rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
// Reglas de seguridad de Firestore — DeliStars (app de domicilios)
//
// Modelo de auth:
//   • Staff (admin/cajero/domiciliario): Google sign-in.
//   • Clientes: cuenta obligatoria (Google, Microsoft o correo verificado).
//     Crean, cancelan y pagan sus pedidos por la API del servidor
//     (/api/v1/pedidos, Fase 4); aquí solo escriben lo que aún no tiene API:
//     agregar productos, chat, calificación y cómo quieren su devolución.
//     Las sesiones anónimas quedan para vacantes y /empresas.
//
// Roles:
//   • Admin: lista hardcodeada (DEBE coincidir con ADMIN_EMAILS del front —
//     ver src/services/roles.js y `npm run check:emails`).
//   • Cajero/Domiciliario: existe un doc cuyo ID es su email en
//     roles_cashiers / roles_drivers (así los resuelve AuthContext), o están
//     en la lista hardcodeada por defecto.
//
// ⚠️ Probar en Rules Playground / emulador ANTES de desplegar a producción.
//    Rollback = restaurar las reglas anteriores en la consola de Firebase.
// ─────────────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    // Sesión del Apple Watch (W-1/W-2, POST /api/v1/auth/reloj): el token trae el
    // claim `reloj` = id en sesiones_reloj. Vale solo mientras ese registro siga
    // activo: al cerrar sesión en el iPhone, el reloj ya no lee ni escribe nada
    // aunque su token no haya vencido. Las demás sesiones no hacen esta lectura.
    function esReloj() { return 'reloj' in request.auth.token; }
    function relojVigente() {
      return !esReloj() || (
        get(/databases/$(database)/documents/sesiones_reloj/$(request.auth.token.reloj)).data.activa == true
        && get(/databases/$(database)/documents/sesiones_reloj/$(request.auth.token.reloj)).data.uid == request.auth.uid
      );
    }
    function isSignedIn() { return request.auth != null && relojVigente(); }
    // El reloj solo actúa como cliente: ningún rol del equipo pasa por él.
    function isTeamSession() { return isSignedIn() && !esReloj(); }
    function userEmail()  { return request.auth.token.email; }

    // Admins hardcodeados (sincronizar con ADMIN_EMAILS del front).
    function isAdmin() {
      return isTeamSession() && userEmail() in [
        'thebesta4321@gmail.com',
        'cdavid.jaramillo@gmail.com'
      ];
    }
    // Cajeros "por defecto" hardcodeados (espejo de DEFAULT_CASHIERS en
    // src/services/roles.js). Pueden NO tener doc en Firestore, por eso se
    // reconocen aquí además del exists() de la colección dinámica.
    function isCashier() {
      return isTeamSession() && (
        userEmail() in [
          'lluis02martinez@gmail.com',
          'vvillegasmazo@gmail.com',
          'cdavid.jaramillo@gmail.com',
          'thebesta4321@gmail.com'
        ]
        || exists(/databases/$(database)/documents/roles_cashiers/$(userEmail()))
      );
    }
    function isDriver() {
      return isTeamSession() && (
        userEmail() in [
          'cdavid.jaramillo@gmail.com'
        ]
        || exists(/databases/$(database)/documents/roles_drivers/$(userEmail()))
      );
    }
    function isStaff() { return isAdmin() || isCashier() || isDriver(); }

    // Mercadeo: entra al panel admin y solo ve Mercadeo y Correo. A propósito
    // NO es staff: no lee pedidos, clientes ni caja. Solo maneja campañas y lee
    // la audiencia (conteos sin datos personales, en config/mercadeo_audiencia).
    // Espejo de MARKETING_EMAILS en delistars-menu-magic/admin/src/lib/team.ts.
    function isMarketing() {
      return isTeamSession() && !exists(/databases/$(database)/documents/roles_disabled/$(userEmail())) && (
        userEmail() in [
          'valenthina5431@gmail.com'
        ]
        || exists(/databases/$(database)/documents/roles_marketing/$(userEmail()))
      );
    }

    // Bot de Firebase Auth (correo/contraseña) dedicado SOLO a abrir/cerrar
    // la plataforma automáticamente (ver delistars-menu-magic/scheduler).
    // A propósito no es admin ni cajero: solo puede tocar config/client_platform
    // y solo los campos active/updatedBy/updatedAt — nada más en toda la base.
    function isAutoOpenBot() {
      return isTeamSession() && userEmail() == 'auto-open@delistars-domicilios.app';
    }

    // Admins de confianza total — pueden modificar fidelización (corregir
    // progreso, otorgar/anular premios manualmente desde /admin/fidelizacion).
    // Subconjunto de isAdmin(): puede haber admins que vean fidelización pero
    // no la modifiquen (hoy la lista coincide con isAdmin()).
    // Espejo de SUPER_ADMIN_EMAILS en delistars-menu-magic/admin/src/lib/team.ts.
    function isSuperAdmin() {
      return isTeamSession() && userEmail() in [
        'thebesta4321@gmail.com',
        'cdavid.jaramillo@gmail.com'
      ];
    }
    // Quién puede escribir el progreso/premios de fidelización: cajero y
    // domiciliario para el flujo automático (entregar pedido, devolver premio
    // al rechazar), y solo los super admins para el manual. isAdmin() a secas
    // NO basta — un admin que no sea super admin queda fuera a propósito.
    function isLoyaltyManager() { return isCashier() || isDriver() || isSuperAdmin(); }

    // ── Pedidos ────────────────────────────────────────────────────────────
    // Cliente: solo los suyos. Cajero: cualquiera (comparten el trabajo), pero
    // solo puede CREAR uno marcado con su propio cashierId (no puede inventar
    // un pedido a nombre de otro cajero). Domiciliario: solo lee/actualiza los
    // que tiene asignados (driverEmail == su email) — así ya filtra su propia
    // consulta en DeliveryPanel.jsx, esto solo lo refuerza del lado servidor.
    // ── Qué puede cambiar cada rol en un pedido (19 oct 2026) ──────────────
    // La caja y el admin cambian todo (cotizan, asignan, corrigen). El cliente y
    // el domiciliario solo los campos que sus pantallas escriben de verdad: así
    // nadie puede, desde la consola del navegador, ponerle total $0 a su pedido,
    // marcarlo entregado o cambiarle el domiciliario. Los cambios de etapa
    // "oficiales" pasan por la API del servidor (/api/v1/pedidos), que usa una
    // cuenta de servicio y no depende de estas reglas.
    function cambiados() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }
    // Campos de etapa que escribe services/firebase.js → actualizarPedido.
    function etapaValida(etapasPermitidas, excepcionesPermitidas) {
      return (!('etapa' in cambiados()) || request.resource.data.etapa in etapasPermitidas)
          && (!('excepcion' in cambiados()) || request.resource.data.excepcion in excepcionesPermitidas)
          && (!('version' in cambiados()) || request.resource.data.version == resource.data.get('version', 0) + 1);
    }
    function clientePuedeActualizar() {
      let d = request.resource.data;
      let antes = resource.data;
      // Lo que aún no tiene API: chat con la caja, calificación y cómo quiere
      // la devolución. Crear, pagar, cancelar, agregar productos y responder
      // a un cambio van por /api/v1/pedidos (Fases 4 y 7).
      return cambiados().hasOnly(['clientMessages', 'rating', 'ratingComment', 'ratedAt', 'devolucion', 'updatedAt'])
        && (!('devolucion' in cambiados())
            || ('devolucion' in antes
                && d.devolucion.diff(antes.devolucion).affectedKeys().hasOnly(['estado', 'datos', 'elegidaAt'])
                // Elige desde por_elegir, o completa lo que dejó a medias en el reloj
                // (transferencia_sin_datos, W-6). Pedir transferencia exige los datos:
                // sin ellos la caja no puede transferir.
                && antes.devolucion.estado in ['por_elegir', 'transferencia_sin_datos']
                && (d.devolucion.estado in ['transferencia_solicitada', 'saldo_solicitado']
                    || (d.devolucion.estado == 'transferencia_sin_datos' && antes.devolucion.estado == 'por_elegir'))
                && (d.devolucion.estado != 'transferencia_solicitada' || 'datos' in d.devolucion)));
    }
    function domiciliarioPuedeActualizar() {
      return cambiados().hasOnly([
          'status', 'acceptedAt', 'preparingAt', 'inTransitAt', 'arrivedAt', 'deliveredAt',
          // llegada estimada y ubicación en vivo
          'etaMin', 'etaLlegadaAt', 'etaDesde', 'driverLat', 'driverLng', 'driverUpdatedAt',
          // corrige la dirección o pega el pin del cliente
          'fullAddress', 'addrLat', 'addrLng', 'addrPinBy', 'addrPinAt',
          'comments',
          'etapa', 'excepcion', 'excepcionMotivo', 'version', 'updatedAt'
        ])
        && (!('status' in cambiados())
            || request.resource.data.status in ['accepted', 'preparing', 'in_transit', 'arrived', 'pending_cuadre', 'completed'])
        && etapaValida(['confirmado', 'en_preparacion', 'listo', 'en_camino', 'llego', 'entregado'], [null]);
    }

    match /orders/{orderId} {
      // El cliente crea sus pedidos por la API del servidor (cuenta obligatoria,
      // precios del catálogo): directo solo la caja y el admin.
      allow create: if isAdmin()
                    || (isCashier() && request.resource.data.cashierId == request.auth.uid);
      // Mercadeo NO lee pedidos (decisión C3, especificación §17.1): sus
      // indicadores son agregados que publica el servidor en mercadeo/indicadores.
      allow read:   if isAdmin() || isCashier()
                    || (isSignedIn() && resource.data.clientUid == request.auth.uid)
                    || (isDriver() && resource.data.driverEmail == userEmail());
      allow update: if isAdmin() || isCashier()
                    || (isSignedIn() && resource.data.clientUid == request.auth.uid && clientePuedeActualizar())
                    || (isDriver() && resource.data.driverEmail == userEmail() && domiciliarioPuedeActualizar());
      allow delete: if isAdmin();
    }

    // ── Solicitudes de acceso al equipo ────────────────────────────────────
    // Las crea y resuelve el servidor (/api/v1/equipo). Cada quien lee la suya
    // (para ver si ya la aprobaron) y administración todas. Nadie escribe directo.
    match /solicitudes_acceso/{uid} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
      allow write: if false;
    }

    // ── Centro de avisos (Fase 6, especificación §18) ──────────────────────
    // avisos/{destino}/items/{evento}: destino = uid del cliente, correo del
    // equipo o caja_<sede> (compartido por la caja de esa sede: el "visto" es
    // de todos). Los crea el scheduler (id = evento: un reintento no duplica);
    // cada quien solo marca los suyos como leídos.
    function esDestino(destino) {
      return isSignedIn() && (
        request.auth.uid == destino
        || userEmail().lower() == destino
        || (destino in ['caja_santa_lucia', 'caja_santa_teresita'] && isCashier())
      );
    }
    match /avisos/{destino}/items/{evento} {
      allow read: if isAdmin() || esDestino(destino);
      allow create: if isAutoOpenBot();
      allow update: if esDestino(destino)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['leido', 'leidoAt', 'leidoPor']);
      allow delete: if isAutoOpenBot();
    }
    // Aparatos que reciben push nativos (app). Los registra el servidor
    // (/api/v1/avisos/dispositivo); el scheduler borra los que ya no sirven.
    match /dispositivos/{destino}/tokens/{id} {
      allow read: if false;
      allow write: if false;
      allow delete: if isAutoOpenBot();
    }
    // Caja con varios aparatos por sede: uno principal suena, los demás solo
    // muestran el aviso. Lo elige la caja (nunca automático); cada aparato
    // reporta que sigue conectado.
    match /caja_puestos/{sedeId} {
      allow read: if isAdmin() || isCashier();
      allow write: if (isAdmin() || isCashier())
                   && request.resource.data.keys().hasOnly(['principal', 'principalNombre', 'principalPor', 'principalDesde', 'latidoPrincipal']);
    }
    match /caja_puestos/{sedeId}/aparatos/{aparatoId} {
      allow read: if isAdmin() || isCashier();
      allow write: if isCashier()
                   && request.resource.data.keys().hasOnly(['nombre', 'email', 'latido']);
    }

    // ── Turno del domiciliario (Fase 5) ────────────────────────────────────
    // Lo escribe el servidor (/api/v1/equipo/turno y la asignación automática).
    // La caja y el admin lo leen para saber quién está disponible; el
    // domiciliario lee el suyo.
    match /turnos_domiciliario/{email} {
      allow read: if isAdmin() || isCashier() || (isSignedIn() && email == userEmail().lower());
      allow write: if false;
    }

    // ── Eliminar la cuenta (Fase 4, paso 4; P-25) ──────────────────────────
    // La solicitud la crea y la ejecuta el servidor (/api/v1/cuenta). El
    // cliente lee la suya para ver el aviso de "tu cuenta se elimina el…".
    match /eliminaciones/{uid} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
      allow write: if false;
    }
    // Saldo a favor que la caja le transfiere a quien eliminó su cuenta. La
    // caja lo lee para hacer la transferencia y lo marca hecho por la API.
    match /devoluciones_saldo/{id} {
      allow read: if isAdmin() || isCashier();
      allow write: if false;
    }

    // ── Historial (auditoría) del pedido — Fase 2 ──────────────────────────
    // Una línea por cada cambio de etapa o excepción. Se escribe junto con el
    // pedido (services/firebase.js → actualizarPedido / createOrderWithNumber)
    // y nunca se edita ni se borra. La lee quien puede leer el pedido.
    match /orders/{orderId}/historial/{entradaId} {
      allow read: if isAdmin() || isCashier()
                  || (isSignedIn() && get(/databases/$(database)/documents/orders/$(orderId)).data.clientUid == request.auth.uid)
                  || (isDriver() && get(/databases/$(database)/documents/orders/$(orderId)).data.driverEmail == userEmail());
      allow create: if isSignedIn() && (
                    isAdmin() || isCashier() || isDriver()
                    || getAfter(/databases/$(database)/documents/orders/$(orderId)).data.clientUid == request.auth.uid
                  );
      allow update, delete: if false;
    }

    // ── Chat cliente ↔ domiciliario (Fase 7, especificación §8.3) ──────────
    // orders/{id}/chat_domiciliario/{mensaje}: lo leen el cliente del pedido, el
    // domiciliario que lo tiene asignado y administración (para reclamos). La
    // caja NO: ese chat es entre quien entrega y quien recibe. Los mensajes los
    // escribe solo el servidor (POST /api/v1/pedidos/:id/mensajes), que revisa
    // quién habla y que el chat siga abierto (hasta 3 h después de la entrega).
    match /orders/{orderId}/chat_domiciliario/{mensajeId} {
      allow read: if isAdmin()
                  || (isSignedIn() && get(/databases/$(database)/documents/orders/$(orderId)).data.clientUid == request.auth.uid)
                  || (isDriver() && get(/databases/$(database)/documents/orders/$(orderId)).data.driverEmail == userEmail());
      allow write: if false;
    }

    // ── Config de la app (config/client_platform, config/eta_stats) ────────
    // Horarios (config/horarios): administración define el horario semanal y las
    // excepciones; la caja solo puede tocar el modo manual de cada sede (abrir o
    // cerrar a mano), firmado con su correo.
    function manualValido(m) {
      return m == null
        || (m.keys().hasOnly(['modo', 'hasta', 'por'])
            && m.modo in ['abierta', 'cerrada']
            && m.por == userEmail());
    }
    // Solo cambia `manual` de la sede (y bien firmado); no puede borrar la sede.
    function sedeSoloManual(s, antes, despues) {
      let previo = s in antes ? antes[s] : {};
      let cambios = s in despues ? despues[s].diff(previo).affectedKeys() : [].toSet();
      return (!(s in antes) || s in despues)
        && cambios.hasOnly(['manual'])
        && (!cambios.hasAny(['manual']) || manualValido(despues[s].get('manual', null)));
    }
    function cajaSoloAperturaManual() {
      let antes = resource == null ? {} : resource.data;
      let despues = request.resource.data;
      return despues.diff(antes).affectedKeys()
               .hasOnly(['santa_lucia', 'santa_teresita', 'actualizadoPor', 'actualizadoAt'])
        && despues.actualizadoPor == userEmail()
        && sedeSoloManual('santa_lucia', antes, despues)
        && sedeSoloManual('santa_teresita', antes, despues);
    }
    match /config/{docId} {
      allow read:  if true;
      allow write: if isAdmin()
                   || (docId == 'horarios' && isCashier() && cajaSoloAperturaManual())
                   || (
                     isAutoOpenBot() && (
                       // Estadísticas de tiempo de entrega que publica el
                       // scheduler (medianas por sede — nada sensible).
                       docId == 'eta_stats'
                       // Conteos de la audiencia de Mercadeo (sin datos personales).
                       || docId == 'mercadeo_audiencia'
                       || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active','updatedBy','updatedAt'])
                     )
                   );
    }

    // ── Listas de roles dinámicos ──────────────────────────────────────────
    // Cajero también puede agregar/editar domiciliarios (CashierPanel.jsx lo
    // usa para "agregar domiciliario" y actualizar su teléfono).
    // ── Tokens de notificación del equipo ──────────────────────────────────
    // Cada cajero/domiciliario guarda aquí el token de SU dispositivo para que
    // el scheduler pueda avisarle con la app cerrada. Solo puede escribir su
    // propio documento (el id es su correo): así nadie puede meterle un token
    // a otro ni desviarle los avisos. Lee solo el admin — el scheduler entra
    // con credenciales de servidor y no pasa por estas reglas.
    match /staff_push/{email} {
      // El id del documento se guarda SIEMPRE en minúsculas, así que se compara
      // contra el correo del token también en minúsculas: si no, alguien con
      // mayúsculas en su correo no podría registrar su propio dispositivo.
      allow read:  if isAdmin() || (isSignedIn() && email == userEmail().lower());
      allow write: if isStaff() && email == userEmail().lower();
    }

    match /roles_cashiers/{email} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }
    match /roles_drivers/{email} {
      allow read:  if isSignedIn();
      allow write: if isAdmin() || isCashier();
    }
    match /roles_marketing/{email} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }
    // Bajas de empleados: anulan roles (fijos o dinámicos). Solo admin.
    match /roles_disabled/{email} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }

    // ── Ubicación de domiciliarios (doc id = email del domiciliario) ────────
    // Solo el propio domiciliario escribe su ubicación. Solo cajero/admin la
    // leen (mapa de despacho) — un cliente cualquiera NO debe ver en vivo
    // dónde está cada domiciliario.
    match /driver_locations/{email} {
      allow read:  if isCashier() || isAdmin();
      allow write: if isAdmin() || (isSignedIn() && userEmail() == email);
    }

    // ── Perfil de cliente (doc id = uid) ───────────────────────────────────
    // El campo "loyalty" (progreso de fidelización por sede) NUNCA lo escribe
    // el cliente — solo isLoyaltyManager() (cajero/domiciliario en el flujo
    // automático, solo super admin en el manual). isAdmin() a secas NO basta:
    // un admin que no sea super admin puede leer fidelización pero no escribirla.
    // El cliente sí puede crear/actualizar el resto de su perfil (nombre, tel,
    // direcciones) con normalidad.
    match /customers/{uid} {
      allow read:   if isStaff() || (isSignedIn() && request.auth.uid == uid);
      allow create: if isLoyaltyManager()
                    || (isSignedIn() && request.auth.uid == uid && !('loyalty' in request.resource.data));
      allow update: if isLoyaltyManager()
                    || (
                      isSignedIn() && request.auth.uid == uid &&
                      !request.resource.data.diff(resource.data).affectedKeys().hasAny(['loyalty'])
                    );
      allow delete: if isAdmin();
    }

    // ── Premios de fidelización (subcolección de customers) ─────────────────
    // Solo isLoyaltyManager() puede CREAR un premio (otorgarlo al entregar el
    // pedido #10/#20/#30, o el otorgamiento manual desde /admin/fidelizacion
    // — este último solo lo puede hacer un super admin). Canjearlo lo hace el
    // servidor al crear el pedido (Fase 4); el cliente solo marca que ya vio
    // el aviso de "ganaste un premio" (notified).
    match /customers/{uid}/rewards/{rewardId} {
      allow read:   if isStaff() || (isSignedIn() && request.auth.uid == uid);
      allow create: if isLoyaltyManager();
      allow delete: if isSuperAdmin();
      allow update: if isLoyaltyManager()
                    || (
                      isSignedIn() && request.auth.uid == uid &&
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['notified'])
                    );
    }

    // ── Saldo a favor (devoluciones de pedidos pagados que no siguieron) ────
    // Solo la caja/admin lo crea y lo corrige. Usarlo en un pedido y
    // devolverlo al cancelar lo hace el servidor (Fase 4): el cliente solo lo lee.
    match /customers/{uid}/credits/{creditId} {
      allow read:   if isStaff() || (isSignedIn() && request.auth.uid == uid);
      allow create, update, delete: if isCashier() || isAdmin();
    }

    // ── Turnos (horarios del equipo) ───────────────────────────────────────
    match /turnos/{weekId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // ── Contador de número de pedido (transacción) ─────────────────────────
    // Lo usa la caja al crear pedidos; los del cliente los numera el servidor.
    match /counters/{docId} {
      allow read, write: if isAdmin() || isCashier();
    }

    // ── Vacantes publicadas (ofertas de trabajo) ──────────────────────────
    // Lectura pública (la página /vacantes/ las muestra a cualquiera);
    // solo el admin publica/edita/borra.
    match /vacantes/{vacanteId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // ── Postulaciones a vacantes (formulario público, sin login) ───────────
    match /vacantes_postulantes/{appId} {
      allow create: if true;            // postulación pública
      allow read, update, delete: if isAdmin();
    }

    // ── Métricas de embudo (carritos que llegan al checkout) ───────────────
    // El cliente (incluso anónimo) registra que entró al checkout con carrito;
    // comparado con los pedidos creados da la tasa de abandono en Reportes.
    // Solo crear (nunca editar/borrar) y solo con su propio uid; lee el admin.
    match /metrics_funnel/{eventId} {
      allow create: if isSignedIn()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.type == 'checkout_started';
      allow read:   if isAdmin();
      allow update, delete: if false;
    }

    // ── Prospectos de cotización para empresas (página /empresas) ───────────
    // Cualquier visitante (login anónimo) puede DEJAR su solicitud; solo el
    // admin puede leerlas. Nadie edita ni borra desde el cliente.
    match /corporate_leads/{leadId} {
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow read:   if isAdmin();
      allow update, delete: if false;
    }

    // ── Campañas de correo (pestaña Mercadeo del panel) ─────────────────────
    // Las crean y editan Mercadeo y el admin. El envío lo hará el servidor,
    // que lee los correos de los clientes con credenciales propias.
    match /campanas/{campanaId} {
      allow read, delete: if isAdmin() || isMarketing();
      // Las métricas y la cola de notificaciones solo las escribe el servidor (§17).
      allow create: if (isAdmin() || isMarketing())
                    && !request.resource.data.keys().hasAny(['metricas', 'cola']);
      allow update: if (isAdmin() || isMarketing())
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['metricas', 'cola']);
      // El scheduler (bot) registra el avance del envío y puede corregir el
      // texto o el enlace del botón. No crea ni borra campañas.
      allow update: if isAutoOpenBot()
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['envio', 'estado', 'mensaje', 'botonUrl', 'actualizadoAt']);
    }

    // ── Todo lo de la pestaña Mercadeo (calendario y lo que venga) ─────────
    // Una sola regla para la carpeta: las funciones nuevas de Mercadeo no
    // necesitan volver a publicar reglas. Ej: mercadeo/calendario/actividades.
    match /mercadeo/{seccion}/{resto=**} {
      allow read:  if isAdmin() || isMarketing();
      // Los indicadores los calcula el servidor: nadie del panel los edita.
      allow write: if (isAdmin() || isMarketing()) && seccion != 'indicadores';
    }
    match /mercadeo/indicadores/dias/{dia} {
      allow write: if isAutoOpenBot();
    }

    // ── Todo lo demás: denegado ────────────────────────────────────────────
    // Sesiones del Apple Watch: solo el servidor las crea y cierra (admin SDK).
    match /sesiones_reloj/{id} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
